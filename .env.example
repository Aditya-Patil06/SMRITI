# Project SMRITI Environment Configuration
# Copy this file to .env and adjust as necessary. Never commit .env with real secrets!

# Environment
SMRITI_ENV=development
SMRITI_DEBUG=true

# Database (Default: local SQLite database in project directory)
SMRITI_DATABASE_URL=sqlite:///./smriti.db

# Storage Directory for exports and local caching
SMRITI_STORAGE_DIR=./storage

# Security
SMRITI_SECRET_KEY=change-this-in-production-to-a-secure-random-token
SMRITI_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Embedding & Search
SMRITI_EMBEDDING_PROVIDER=local
SMRITI_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Provider Integration Defaults
# API keys are optional and only needed if invoking provider APIs directly
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
